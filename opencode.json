{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "lsp": {
    "python": {
      "command": ["npx", "-y", "pyright-langserver", "--stdio"],
      "extensions": [".py"],
      "env": {
        "VENV_PATH": ".venv"
      }
    }
  },
  "formatter": {
    "ruff": {
      "command": [".venv/bin/ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "watcher": {
    "ignore": [
      ".venv/**",
      "__pycache__/**",
      "*.pyc",
      ".ipynb_checkpoints/**"
    ]
  }
}
